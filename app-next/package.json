{
    "name": "mainsail-next",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Vue 3 + shadcn-vue rewrite of the Mainsail UI (fork). Reuses the Moonraker data layer from the Vue 2 tree.",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "build:nocheck": "vite build",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "probe": "node scripts/probe-moonraker.mjs"
    },
    "dependencies": {
        "@mdi/js": "^7.4.47",
        "@sindarius/gcodeviewer": "^3.7.17",
        "@vueuse/core": "^13.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "echarts": "^5.6.0",
        "echarts-gl": "^2.1.0",
        "pinia": "^4.0.3",
        "reka-ui": "^2.10.3",
        "tailwind-merge": "^3.0.0",
        "vue": "^3.5.41",
        "vue-echarts": "^7.0.3",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^20.19.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "puppeteer-core": "^25.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "^5.9.0",
        "vite": "^8.2.1",
        "vue-tsc": "^2.2.0"
    }
}
